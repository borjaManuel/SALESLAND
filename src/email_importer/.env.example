# ============================================================
# IMAP CONFIGURATION
# ============================================================

# IMAP server hostname
IMAP_SERVER=imap.host.com

# IMAP SSL port
IMAP_PORT=993

# Mailbox credentials
IMAP_USER=usuario@host.com
IMAP_PASSWORD=

# Mailbox folder to process
IMAP_FOLDER=INBOX


# ============================================================
# IMPORTER CONFIGURATION
# ============================================================

# Folder where PDF attachments will be stored
PDF_OUTPUT_FOLDER=C:\Output\path\to\pdfs

# ============================================================
# LOGGING CONFIGURATION
# ============================================================

# Logging level
LOG_LEVEL=INFO