DB_HOST=localhost
DB_PORT=5432
DB_NAME=salesland_test
DB_USER=postgres
DB_PASSWORD=postgres
#Schema where the tables are created and loaded (read by InfoInput as exchange.*).
#Leave empty to use the database default schema.
DB_SCHEMA=exchange


#################### FOLDERS ####################
#Periodic data directory
PERIODIC_DATA_DIR=C:\Users\bmmartinez\Documents\workspace_python\SALESLAND\periodic

#VISA batches are imported by visa_import.py (not by periodic_import.py).
#Shared folder where the customer leaves the VISA batches.
#Each batch is a folder named DD-MM-YYYY (or DD-MM-YYYY_N for several batches
#on the same day) containing one reference .xlsx file (any name) and the
#invoice PDFs.
VISA_DATA_DIR=E:\DATA\INPUT\FACTURAS-ENTRANTES\FACTURAS-VISA

#Local folder watched by InfoInput. The PDFs of each batch are moved to
#VISA_OUTPUT_DIR\<batch>\ renamed as <invoice>_<batch>.pdf
VISA_OUTPUT_DIR=C:\SALESLAND\periodic\visa

#Minutes a VISA batch must remain unchanged before being imported (optional, default 2).
VISA_MINIMUM_AGE_MINUTES=

#Local folder for the processed VISA Excel files (optional).
#Defaults to PERIODIC_DATA_DIR\history\visa
VISA_HISTORY_DIR=
