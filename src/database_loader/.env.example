DB_HOST=localhost
DB_PORT=5432
DB_NAME=salesland_test
DB_USER=postgres
DB_PASSWORD=postgres


#################### FOLDERS ####################
#Periodic data directory
PERIODIC_DATA_DIR=C:\Users\bmmartinez\Documents\workspace_python\SALESLAND\periodic

#Shared folder where the customer leaves the VISA batches.
#Each batch is a folder named DD-MM-YYYY (or DD-MM-YYYY_N for several batches
#on the same day) containing "REFERENCIA FRAS.VISA.xlsx" and the invoice PDFs.
VISA_DATA_DIR=\\server\share\VISA

#Local folder watched by InfoInput. The PDFs of each batch are moved to
#VISA_OUTPUT_DIR\<batch>\ renamed as <invoice>_<batch>.pdf
VISA_OUTPUT_DIR=E:\DATA\INPUT\FACTURAS-ENTRANTES\FACTURAS-VISA

#Local folder for the processed VISA Excel files (optional).
#Defaults to PERIODIC_DATA_DIR\history\visa
VISA_HISTORY_DIR=
